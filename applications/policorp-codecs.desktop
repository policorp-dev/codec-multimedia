[Desktop Entry]
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Mixer;GNOME;GTK;
StartupNotify=false
Name=Instalar Codecs Multimídia
Exec=env GDK_BACKEND=x11 /usr/share/policorp-codecs/codec-multimedia
Icon=codec-icon
Comment=An easy way to install codecs on Policorp Linux.
Comment[pt_BR]=Um facilitador para instalação de codecs no Policorp Linux.
Keywords=desktop;preferences;
StartupWMClass=Codec-Multimedia
